{
  "name": "mastra-mcp",
  "version": "0.1.0",
  "description": "MCP server that gives coding agents up-to-date Mastra docs, API reference, examples and guides (like Context7)",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "tsc -p tsconfig.json && node --test .build/test/*.test.js",
    "start": "node dist/index.js",
    "prepublishOnly": "npm test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nahisaho/mastra-mcp.git"
  },
  "keywords": [
    "mcp",
    "mastra",
    "model-context-protocol",
    "docs",
    "coding-agent"
  ],
  "type": "module",
  "bugs": {
    "url": "https://github.com/nahisaho/mastra-mcp/issues"
  },
  "homepage": "https://github.com/nahisaho/mastra-mcp#readme",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "bin": {
    "mastra-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "author": "nahisaho",
  "publishConfig": {
    "access": "public"
  }
}
